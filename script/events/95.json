 },
 {
  "id": "ev_95A1B8",
  "addr": "95:A1B8",
  "op": "95A1B7",
  "len": 31,
  "jp": "{c0C:01}「ずいぶんと年期の入った{br}ジュークボックスだな。{end}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_95A2AA",
  "addr": "95:A2AA",
  "op": "95A2A9",
  "len": 30,
  "jp": "{br} す ヒちぬマスター「いらっしゃい。注文はなんだい？{endFD}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_95A2C9",
  "addr": "95:A2C9",
  "op": "95A2C8",
  "len": 48,
  "jp": "飲み物だったらコーヒーはもちろん、{br}カイピリーニャなんかのアルコール類も{br}扱ってるよ。{endFD}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_95A2FA",
  "addr": "95:A2FA",
  "op": "95A2F9",
  "len": 65,
