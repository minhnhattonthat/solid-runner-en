  "notes": ""
 },
 {
  "id": "ev_95A123",
  "addr": "95:A123",
  "op": "95A122",
  "len": 59,
  "jp": "「何だか街がぶっそうになってきている{br}ようじゃが、ゆっくりとコーヒーが飲める{br}世の中になって欲しいのう。{end}",
