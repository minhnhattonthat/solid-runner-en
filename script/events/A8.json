  "notes": ""
 },
 {
  "id": "ev_A897BE",
  "addr": "A8:97BE",
  "op": "A897BD",
  "len": 50,
  "jp": "{c0C:01}「ああ。イオンがよく看病して{br}いてくれたからな。{br}おかげで時間をかけなくて済んだ。{end}",
