  "jp": "「こりゃ、本人に言いつけるぞ。{end}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_A8ACC3",
  "addr": "A8:ACC3",
  "op": "A8ACC2",
  "len": 36,
  "jp": "{c0C:01}「半年も寝ていたんだ。{br}十分過ぎる程、休んだぜ。{end}",
