 },
 {
  "id": "ev_A896EC",
  "addr": "A8:96EC",
  "op": "A896EB",
  "len": 16,
  "jp": "「本当によかった、{c0C:01}。{end}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_A89783",
  "addr": "A8:9783",
  "op": "A89782",
  "len": 57,
