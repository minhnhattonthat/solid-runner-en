  "notes": ""
 },
 {
  "id": "ev_A8A97C",
  "addr": "A8:A97C",
  "op": "A8A97B",
  "len": 20,
  "jp": "「そうか、じゃあ話を聞いてみよう。{end}",
  "en": "",
  "notes": ""
 },
