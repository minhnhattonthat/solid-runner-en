  "id": "ev_A5EE6C",
  "addr": "A5:EE6C",
  "op": "A5EE6B",
  "len": 43,
  "jp": "「虫ケラが…。貴様がどれほどあがこうと、{br}この私を倒す事などできぬわ。{endFD}",
  "en": "",
  "notes": ""
 },
