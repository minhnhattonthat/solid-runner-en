  "id": "ev_A5EF62",
  "addr": "A5:EF62",
  "op": "A5EF61",
  "len": 38,
  "jp": "「不老不死だと、そんな事が可能だとでも{br}思っているのか！？{end}",
  "en": "",
  "notes": ""
