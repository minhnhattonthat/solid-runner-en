 },
 {
  "id": "ev_948F9C",
  "addr": "94:8F9C",
  "op": "948F9B",
  "len": 15,
  "jp": "{c0C:01}「おっ、それもいいな。{end}",
  "en": "",
  "notes": ""
 },
 {
  "id": "ev_948FB0",
